    {
      "path": "src/design-system/sidebar.stories.tsx",
      "type": "registry:file",
      "target": "@ui/sidebar.stories.tsx",
      "content": "import type { Meta, StoryObj } from \"@storybook/react-vite\";\r\nimport { CalendarDays, Users } from \"lucide-react\";\r\nimport { Sidebar, SidebarMain, SidebarNavigation } from \".\";\r\nimport { SidebarExamples } from \"./sidebar-examples\";\r\nconst meta = { title: \"Components/Core/Sidebar\", component: Sidebar, tags: [\"autodocs\"], parameters: { layout: \"centered\" } } satisfies Meta<typeof Sidebar>;\r\nexport default meta;\r\ntype Story = StoryObj<typeof meta>;\r\nexport const Expanded: Story = { render: () => <SidebarExamples comparison={false} /> };\r\nexport const Collapsed: Story = { render: () => <SidebarExamples defaultCollapsed comparison={false} /> };\r\nexport const FigmaComparison: Story = { render: () => <SidebarExamples /> };\r\nexport const ItemStates: Story = { render: () => <div style={{ height: 320 }}><Sidebar><SidebarMain><SidebarNavigation activeId=\"planner\" groups={[{ label: \"Class Management\", items: [{ id: \"planner\", label: \"Planner\", icon: <CalendarDays size={18} />, badge: 3 }, { id: \"students\", label: \"Students\", icon: <Users size={18} />, disabled: true }] }]} /></SidebarMain></Sidebar></div> };\r\n"
    },
    {
      "path": "src/design-system/sidebar-examples.tsx",
      "type": "registry:file",
      "target": "@ui/sidebar-examples.tsx",
      "content": "\"use client\";\r\n/* eslint-disable @next/next/no-img-element -- Shared SVG branding must also render in Storybook and registry consumers. */\r\nimport { useState } from \"react\";\r\nimport { CalendarDays, FolderOpen, GraduationCap, LayoutDashboard, LifeBuoy, PanelLeftClose, PanelLeftOpen, Users } from \"lucide-react\";\r\nimport { Avatar, IconButton, Sidebar, SidebarMain, SidebarFooter, SidebarNavigation, type SidebarNavGroup } from \".\";\r\n\r\nconst groups: SidebarNavGroup[] = [\r\n  { label: \"Overview\", items: [{ id: \"dashboard\", label: \"Dashboard\", icon: <LayoutDashboard size={18} aria-hidden=\"true\" /> }, { id: \"analytics\", label: \"Learning Analytics\", icon: <GraduationCap size={18} aria-hidden=\"true\" /> }] },\r\n  { label: \"Class Management\", items: [{ id: \"planner\", label: \"Planner\", icon: <CalendarDays size={18} aria-hidden=\"true\" /> }, { id: \"resources\", label: \"My Resources\", icon: <FolderOpen size={18} aria-hidden=\"true\" /> }] },\r\n  { label: \"Students Management\", items: [{ id: \"students\", label: \"Students\", icon: <Users size={18} aria-hidden=\"true\" /> }] },\r\n];\r\nexport function SidebarExamples({ defaultCollapsed = false, comparison = true }: { defaultCollapsed?: boolean; comparison?: boolean }) {\r\n  const [collapsed, setCollapsed] = useState(defaultCollapsed);\r\n  const [active, setActive] = useState(\"planner\");\r\n  const [notice, setNotice] = useState(\"\");\r\n  const selected = groups.flatMap(group => group.items).find(item => item.id === active)?.label;\r\n  return <><div className=\"ds-doc-sidebar-example\"><Sidebar collapsed={collapsed} aria-label=\"Product sidebar\"><SidebarMain><div className=\"ds-doc-sidebar-header\">{!collapsed && <img src=\"/flexge-logo.svg\" width={68} height={32} alt=\"Flexge\" />}<IconButton variant=\"ghost\" size=\"small\" label={collapsed ? \"Expand sidebar\" : \"Collapse sidebar\"} aria-expanded={!collapsed} icon={collapsed ? <PanelLeftOpen /> : <PanelLeftClose />} onClick={() => setCollapsed(value => !value)} /></div><SidebarNavigation groups={groups} activeId={active} collapsed={collapsed} onItemSelect={setActive} /></SidebarMain><SidebarFooter><Avatar name=\"André Martins\" src=\"/teacher-avatar-andre.png\" size=\"tiny\" /><IconButton label=\"Support\" size=\"small\" variant=\"ghost\" icon={<LifeBuoy />} onClick={() => setNotice(\"Support selected in this example.\")} /></SidebarFooter></Sidebar><section className=\"ds-doc-sidebar-workspace\" aria-label=\"Example workspace\"><h3>{selected}</h3><p>Choose a module, collapse a group or switch to the icon rail.</p><p role=\"status\">{notice || `${selected} selected. No product data was changed.`}</p></section></div>{comparison && <div className=\"ds-doc-sidebar-comparison\"><h3>Figma and product comparison</h3><table><thead><tr><th scope=\"col\">Property</th><th scope=\"col\">Figma</th><th scope=\"col\">Current product</th></tr></thead><tbody><tr><th scope=\"row\">Expanded width</th><td>240px</td><td>240px</td></tr><tr><th scope=\"row\">Collapsed width / item height</th><td>52px / 36px</td><td>64px / 32px</td></tr><tr><th scope=\"row\">Expanded items / group labels</th><td>32px / 30px</td><td>32px / 30px; compact viewport: 29px / 25px</td></tr><tr><th scope=\"row\">Icons</th><td>20px slots</td><td>18px expanded; 17px collapsed</td></tr><tr><th scope=\"row\">Container padding / background</th><td>16px / #f3f4f6</td><td>8px / #f9fafb (light)</td></tr><tr><th scope=\"row\">Item radius</th><td>6px expanded; 4px collapsed</td><td>10px</td></tr><tr><th scope=\"row\">Selection / typography</th><td>Primary background, white text; 14px / 21px; labels 12px / 16px</td><td>Same pattern</td></tr><tr><th scope=\"row\">Nested items / item menus</th><td>Second-level rail and dropdown variants</td><td>Product currently uses flat items inside collapsible groups</td></tr></tbody></table><p>The preview and Planner share the same component. Existing product dimensions are preserved; this comparison does not claim full visual parity with Figma.</p></div>}</>;\r\n}\r\n"
    },
