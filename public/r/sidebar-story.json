    {
      "path": "src/design-system/documentation.css",
      "type": "registry:style",
      "target": "@ui/documentation.css",
      "content": ".ds-doc-color-grid{display:grid;grid-template-columns:repeat(3,minmax(150px,1fr));gap:12px;margin:16px 0 24px}.ds-doc-color-grid>div{display:grid;grid-template-columns:32px 1fr;gap:2px 8px;align-items:center;padding:12px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-md);background:var(--ds-surface)}.ds-doc-color-grid span{width:32px;height:32px;grid-row:span 2;border:1px solid var(--ds-border);border-radius:var(--ds-radius-sm)}.ds-doc-color-grid small{color:var(--ds-muted)}.ds-doc-type-sample{display:grid;gap:2px;padding:12px 0;border-bottom:1px solid var(--ds-border)}.ds-doc-type-sample small{color:var(--ds-muted)}.ds-doc-type-display{font-size: var(--ds-font-size-3xl);line-height: var(--ds-line-height-3xl);font-weight: var(--ds-font-weight-bold)}.ds-doc-type-heading{font-size: var(--ds-font-size-xl);line-height: var(--ds-line-height-xl);font-weight: var(--ds-font-weight-semibold)}.ds-doc-type-body{font-size: var(--ds-font-size-sm);line-height: var(--ds-line-height-sm)}.ds-doc-type-caption{font-size: var(--ds-font-size-xs);line-height: var(--ds-line-height-xs);color:var(--ds-muted)}\r\n.ds-doc-token-table{display:grid;margin:16px 0 28px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-md);overflow:hidden}.ds-doc-token-row{display:grid;grid-template-columns:64px minmax(180px,1fr) minmax(180px,1fr);align-items:center;gap:12px;min-height:48px;padding:8px 12px;border-bottom:1px solid var(--ds-border);background:var(--ds-surface)}.ds-doc-token-row:last-child{border-bottom:0}.ds-doc-token-header{min-height:36px;color:var(--ds-muted);background:var(--ds-surface-soft);font-size: var(--ds-font-size-xs); line-height: var(--ds-line-height-xs);font-weight: var(--ds-font-weight-semibold)}.ds-doc-swatch{width:32px;height:32px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-sm)}.ds-doc-token-row span:last-child{color:var(--ds-muted);font-size: var(--ds-font-size-sm); line-height: var(--ds-line-height-sm)}.ds-doc-status-grid{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 24px}.ds-doc-status-grid .ds-badge{display:inline-flex;flex-direction:column;align-items:flex-start;gap:1px}.ds-doc-status-grid small{font-size: var(--ds-font-size-xs); line-height: var(--ds-line-height-xs);font-weight: var(--ds-font-weight-medium);opacity:.75}.ds-doc-radius-grid{display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));gap:12px;margin:16px 0 28px}.ds-doc-radius-grid>div{display:grid;gap:8px}.ds-doc-radius-grid span{height:64px;border:1px solid var(--ds-primary);background:var(--ds-primary-soft)}.ds-doc-radius-grid small,.ds-doc-shadow-grid small,.ds-doc-state-grid small{color:var(--ds-muted);font-size: var(--ds-font-size-xs); line-height: var(--ds-line-height-xs)}.ds-doc-shadow-grid{display:grid;grid-template-columns:repeat(4,minmax(140px,1fr));gap:16px;margin:16px 0 28px}.ds-doc-shadow-grid>div{display:grid;gap:8px;min-height:92px;padding:16px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-md);background:var(--ds-surface)}.ds-doc-state-grid{display:grid;grid-template-columns:repeat(3,minmax(150px,1fr));gap:16px;margin:16px 0 24px}.ds-doc-state-grid>div{display:grid;gap:8px}.ds-doc-state-sample{display:inline-flex;align-items:center;justify-content:center;min-height:40px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-sm);background:var(--ds-surface);font-size: var(--ds-font-size-sm); line-height: var(--ds-line-height-sm)}.ds-doc-state-focus{border-color:var(--ds-primary);box-shadow:var(--ds-focus-ring)}.ds-doc-state-error{border-color:var(--ds-danger);box-shadow:var(--ds-error-ring)}.ds-doc-state-disabled{opacity:.6}.ds-doc-type-sample code{color:var(--ds-primary);font-size: var(--ds-font-size-xs); line-height: var(--ds-line-height-xs)}\r\n@media (max-width: 800px){.ds-doc-radius-grid{grid-template-columns:repeat(3,minmax(100px,1fr))}.ds-doc-shadow-grid{grid-template-columns:repeat(2,minmax(140px,1fr))}.ds-doc-state-grid{grid-template-columns:1fr}.ds-doc-token-row{grid-template-columns:48px 1fr}.ds-doc-token-row span:last-child{grid-column:2}}\r\n\r\n.ds-doc-card-examples { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));align-items:stretch;gap:24px;width:100%; }\r\n.ds-doc-card { display:flex;flex-direction:column;min-width:0;width:100%; }\r\n.ds-doc-card .ds-card__body { flex:1; }\r\n.ds-doc-card-heading { display:flex;align-items:start;justify-content:space-between;flex-wrap:wrap;gap:12px; }\r\n.ds-doc-card h3 { margin:0 0 6px;font-size:16px;line-height:24px;font-weight:600;letter-spacing:0; }\r\n.ds-doc-card-heading p { margin:0;color:var(--ds-muted);font-size:var(--ds-font-size-xs);line-height:18px; }\r\n.ds-doc-card-details { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:0; }\r\n.ds-doc-card-details dt { margin-bottom:4px;color:var(--ds-muted);font-size:var(--ds-font-size-xs); }\r\n.ds-doc-card-details dd { margin:0;font-size:var(--ds-font-size-sm); }\r\n.ds-doc-card-resources { display:grid;gap:16px;padding:0;margin:0;list-style:none; }\r\n.ds-doc-card-resources li { display:flex;align-items:center;gap:12px; }\r\n.ds-doc-card-resource-icon { display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-sm);color:var(--ds-primary);background:var(--ds-surface-soft); }\r\n.ds-doc-card-resources li > div { display:grid;gap:4px;min-width:0; }\r\n.ds-doc-card-resources strong { font-size:var(--ds-font-size-sm);font-weight:500; }\r\n.ds-doc-card-resources li > div > span { color:var(--ds-muted);font-size:var(--ds-font-size-xs); }\r\n.ds-doc-card-actions { display:flex;justify-content:flex-end;align-items:center;flex-wrap:wrap;gap:8px;padding-top:16px;border-top:1px solid var(--ds-border); }\r\n.ds-doc-sidebar-example { display:flex;width:600px;max-width:100%;height:480px;overflow:hidden;border:1px solid var(--ds-border);border-radius:6px;margin-block:20px;background:var(--ds-surface); }\r\n.ds-doc-sidebar-header { display:flex;align-items:center;justify-content:space-between;height:56px;padding:8px 12px; }\r\n.is-collapsed .ds-doc-sidebar-header { justify-content:center;padding:8px; }\r\n.ds-doc-sidebar-workspace { flex:1;min-width:0;padding:24px;border-left:1px solid var(--ds-border); }\r\n.ds-doc-sidebar-workspace h3,.ds-doc-sidebar-comparison h3 { margin:0 0 8px;font-size:16px;font-weight:600; }\r\n.ds-doc-sidebar-workspace p { color:var(--ds-muted);font-size:12px;line-height:20px;margin:0 0 16px; }\r\n.ds-doc-sidebar-comparison { max-width:100%;overflow-x:auto;margin:24px 0 16px; }\r\n.ds-doc-sidebar-comparison table { width:100%;border-collapse:collapse;font-size:12px;line-height:20px;text-align:left; }\r\n.ds-doc-sidebar-comparison th,.ds-doc-sidebar-comparison td { padding:8px 12px;border-bottom:1px solid var(--ds-border);vertical-align:top; }\r\n.ds-doc-sidebar-comparison th { font-weight:600; }\r\n.ds-doc-sidebar-comparison > p { font-size:12px;line-height:20px;color:var(--ds-muted); }\r\n[data-theme=\"dark\"] .ds-doc-sidebar-header > img { filter:brightness(0) invert(1); }\r\n@media (max-width:600px) { .ds-doc-sidebar-workspace { padding:12px; } }\r\n"
