      "path": "src/design-system/tokens.css",
      "type": "registry:style",
      "target": "@ui/tokens.css",
      "content": "@import \"./palette.css\";\r\n\r\n/* Shared timing and easing for component interactions. */\r\n:root {\r\n  --ds-motion-fast: 120ms;\r\n  --ds-motion-enter: 160ms;\r\n  --ds-motion-exit: 120ms;\r\n  --ds-motion-dialog-enter: 200ms;\r\n  --ds-motion-dialog-exit: 150ms;\r\n  --ds-motion-layout: 200ms;\r\n  --ds-motion-loading: 1600ms;\r\n  --ds-motion-ease: cubic-bezier(.2, 0, .38, .9);\r\n  --ds-motion-ease-enter: cubic-bezier(0, 0, .38, .9);\r\n  --ds-motion-ease-exit: cubic-bezier(.2, 0, 1, .9);\r\n  --ds-motion-distance: 4px;\r\n  --ds-motion-scale: .98;\r\n  --ds-background: var(--ds-color-gray-50);\r\n  --ds-surface: var(--ds-color-white);\r\n  --ds-surface-soft: var(--ds-color-gray-50);\r\n  --ds-secondary: var(--ds-color-gray-100);\r\n  --ds-placeholder: var(--ds-color-slate-200);\r\n  --ds-slider-track: var(--ds-color-slate-300);\r\n  --ds-border: var(--ds-color-gray-300);\r\n  --ds-foreground: var(--ds-color-gray-700);\r\n  --ds-muted: var(--ds-color-gray-500);\r\n  --ds-primary: var(--ds-color-flexge-blue-600);\r\n  --ds-primary-hover: #214f78;\r\n  --ds-primary-active: color-mix(in srgb, var(--ds-primary-hover) 85%, black);\r\n  --ds-accent-active: color-mix(in srgb, var(--ds-accent-hover) 85%, black);\r\n  --ds-danger-active: color-mix(in srgb, var(--ds-danger-hover) 85%, black);\r\n  --ds-primary-soft: #eaf4fc;\r\n  --ds-menu-highlight: var(--ds-color-flexge-blue-100);\r\n  --ds-menu-selected: var(--ds-color-flexge-blue-200);\r\n  --ds-accent: var(--ds-color-flexge-violet-600);\r\n  --ds-accent-hover: #6a32db;\r\n  --ds-danger: var(--ds-color-red-600);\r\n  --ds-success: var(--ds-color-teal-700);\r\n  --ds-warning: var(--ds-color-amber-700);\r\n  --ds-status-slate: var(--ds-color-slate-500);\r\n  --ds-status-slate-soft: var(--ds-color-slate-100);\r\n  --ds-status-amber: var(--ds-color-amber-700);\r\n  --ds-status-amber-soft: var(--ds-color-amber-100);\r\n  --ds-status-violet: var(--ds-color-flexge-violet-700);\r\n  --ds-status-violet-soft: var(--ds-color-flexge-violet-50);\r\n  --ds-status-teal: var(--ds-color-teal-700);\r\n  --ds-status-teal-soft: var(--ds-color-teal-100);\r\n  --ds-radius-sm: 6px;\r\n  --ds-overlay-radius: var(--ds-radius-sm);\r\n  --ds-radius-md: 10px;\r\n  --ds-radius-lg: 14px;\r\n  --ds-radius-xl: 18px;\r\n  --ds-radius-full: 9999px;\r\n  --ds-space-1: 4px;\r\n  --ds-space-2: 8px;\r\n  --ds-space-3: 12px;\r\n  --ds-space-4: 16px;\r\n  --ds-space-5: 20px;\r\n  --ds-space-6: 24px;\r\n  --ds-shadow-sm: 0 1px 2px rgba(0, 0, 0, .05);\r\n  --ds-shadow-md: 0 1px 3px rgba(15, 23, 42, .08), 0 6px 16px rgba(15, 23, 42, .06);\r\n  --ds-shadow-lg: 0 12px 28px rgba(15, 23, 42, .14), 0 2px 6px rgba(15, 23, 42, .08);\r\n  --ds-shadow-popover: 0 14px 32px rgba(15, 23, 42, .16), 0 2px 6px rgba(15, 23, 42, .07);\r\n  --ds-control-height: 32px;\r\n  --ds-focus-ring: 0 0 0 3px var(--ds-focus-color);\r\n  --ds-error-ring: 0 0 0 3px var(--ds-error-color);\r\n  --ds-font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\r\n  --ds-font-size-xs: 0.75rem;\r\n  --ds-line-height-xs: 1rem;\r\n  --ds-font-size-sm: 0.875rem;\r\n  --ds-line-height-sm: 1.3125rem;\r\n  --ds-font-size-base: 1rem;\r\n  --ds-line-height-base: 1.5rem;\r\n  --ds-font-size-lg: 1.125rem;\r\n  --ds-line-height-lg: 1.75rem;\r\n  --ds-font-size-xl: 1.25rem;\r\n  --ds-line-height-xl: 1.75rem;\r\n  --ds-font-size-2xl: 1.5rem;\r\n  --ds-line-height-2xl: 2rem;\r\n  --ds-font-size-3xl: 1.875rem;\r\n  --ds-line-height-3xl: 2.25rem;\r\n  --ds-font-size-4xl: 2.25rem;\r\n  --ds-line-height-4xl: 2.5rem;\r\n  --ds-line-height-none: 1;\r\n  --ds-font-weight-normal: 400;\r\n  --ds-font-weight-medium: 500;\r\n  --ds-font-weight-semibold: 600;\r\n  --ds-font-weight-bold: 700;\r\n}\r\n\r\n[data-theme=\"dark\"] {\r\n  --ds-background: #181a20;\r\n  --ds-surface: #181a20;\r\n  --ds-surface-soft: #20232b;\r\n  --ds-secondary: #272b34;\r\n  --ds-placeholder: #3a404b;\r\n  --ds-slider-track: var(--ds-color-slate-600);\r\n  --ds-border: #3a404b;\r\n  --ds-foreground: #f5f7fa;\r\n  --ds-muted: #a8b3c2;\r\n  --ds-primary: #4f86b5;\r\n  --ds-primary-hover: #6399c7;\r\n  --ds-primary-soft: #1d344a;\r\n  --ds-menu-highlight: #1d344a;\r\n  --ds-menu-selected: #244969;\r\n  --ds-accent: #8b65ed;\r\n  --ds-accent-hover: #9d7bf2;\r\n  --ds-danger: #ff8b83;\r\n  --ds-success: #5fd2c2;\r\n  --ds-warning: #f5b84b;\r\n  --ds-status-slate: #a8b3c2;\r\n  --ds-status-slate-soft: #2b313b;\r\n  --ds-status-amber: #f5b84b;\r\n  --ds-status-amber-soft: #493719;\r\n  --ds-status-violet: #b29af5;\r\n  --ds-status-violet-soft: #302747;\r\n  --ds-status-teal: #5fd2c2;\r\n  --ds-status-teal-soft: #173d3c;\r\n  --ds-shadow-sm: 0 1px 2px rgba(0, 0, 0, .24);\r\n  --ds-shadow-md: 0 1px 3px rgba(0, 0, 0, .28), 0 8px 20px rgba(0, 0, 0, .18);\r\n  --ds-shadow-lg: 0 16px 36px rgba(0, 0, 0, .34), 0 2px 8px rgba(0, 0, 0, .24);\r\n  --ds-shadow-popover: 0 18px 40px rgba(0, 0, 0, .42), 0 2px 8px rgba(0, 0, 0, .28);\r\n}\r\n\r\n.ds-root {\r\n  color: var(--ds-foreground);\r\n  background: var(--ds-background);\r\n  font-family: var(--ds-font-sans);\r\n  font-size: var(--ds-font-size-sm); line-height: var(--ds-line-height-sm);\r\n}\r\n\r\n.ds-root *, .ds-root *::before, .ds-root *::after { box-sizing: border-box; }\r\n.ds-root button, .ds-root input, .ds-root select, .ds-root textarea { font-family: inherit; }\r\n:root {\r\n  --ds-focus-color: var(--ds-color-flexge-blue-200);\r\n  --ds-error-color: var(--ds-color-red-100);\r\n  --ds-secondary-ring: 0 0 0 3px var(--ds-secondary);\r\n  --ds-danger-hover: var(--ds-color-red-700);\r\n  --ds-badge-neutral: var(--ds-color-slate-50);\r\n  --ds-badge-neutral-strong: var(--ds-color-slate-100);\r\n  --ds-badge-danger: var(--ds-color-red-50);\r\n  --ds-badge-danger-strong: var(--ds-color-red-100);\r\n  --ds-badge-danger-border: var(--ds-color-red-300);\r\n  --ds-badge-success: var(--ds-color-teal-50);\r\n  --ds-badge-success-strong: var(--ds-color-teal-100);\r\n  --ds-badge-success-border: var(--ds-color-teal-300);\r\n  --ds-shadow-md: 0 1px 3px rgb(0 0 0 / .1), 0 1px 2px -1px rgb(0 0 0 / .1);\r\n}\r\n[data-theme=\"dark\"] {\r\n  --ds-focus-color: #1d344a;\r\n  --ds-error-color: #49302e;\r\n  --ds-danger-hover: #ef7770;\r\n  --ds-badge-neutral: #20232b;\r\n  --ds-badge-neutral-strong: #2b313b;\r\n  --ds-badge-danger: #302323;\r\n  --ds-badge-danger-strong: #49302e;\r\n  --ds-badge-danger-border: #a74b46;\r\n  --ds-badge-success: #173d3c;\r\n  --ds-badge-success-strong: #20524c;\r\n  --ds-badge-success-border: #31766b;\r\n  --ds-shadow-md: 0 1px 3px rgb(0 0 0 / .28), 0 1px 2px -1px rgb(0 0 0 / .28);\r\n}\r\n\r\n:root { --ds-avatar-foreground:var(--ds-color-flexge-blue-700); }\r\n[data-theme=\"dark\"] { --ds-avatar-foreground:#9fc8ed; }\r\n"
