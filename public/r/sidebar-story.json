\r\n.ds-checkbox:is([data-state=\"checked\"],[data-state=\"indeterminate\"]):active:not(:disabled):not([aria-invalid=\"true\"]) { background:var(--ds-primary-active);border-color:var(--ds-primary-active); }\r\n.ds-radio-shell:has(input:hover:not(:disabled):not([data-invalid])):not(:has(input:focus-visible)) { box-shadow:0 0 0 3px var(--ds-secondary); }\r\n.ds-radio-shell:has(input:active:not(:disabled):not([data-invalid])):not(:has(input:focus-visible)) { box-shadow:0 0 0 3px var(--ds-primary-soft); }\r\n.ds-switch-shell:has(input:hover:not(:disabled)) .ds-switch-track { background:var(--ds-border); }\r\n.ds-switch-shell:has(input:checked:hover:not(:disabled)) .ds-switch-track { background:var(--ds-primary-hover); }\r\n.ds-switch-shell:has(input:checked:active:not(:disabled)) .ds-switch-track { background:var(--ds-primary-active); }\r\n.ds-input-action:active:not(:disabled),.ds-toast-action:active:not(:disabled),.ds-table-sort:active:not(:disabled) { background:var(--ds-border);color:var(--ds-foreground); }\r\n.ds-sonner-host [data-sonner-toast].ds-toast .ds-toast-action:hover:not(:disabled) { background:var(--ds-border); }\r\n.ds-sonner-host [data-sonner-toast].ds-toast .ds-toast-action:active:not(:disabled) { background:var(--ds-border);color:var(--ds-foreground);box-shadow:inset 0 0 0 1px var(--ds-muted); }\r\n.ds-combobox-trigger:active:not(:disabled):not([aria-invalid=\"true\"]),.ds-select:active:not(:disabled):not([aria-invalid=\"true\"]) { background:var(--ds-surface-soft);border-color:var(--ds-primary); }\r\n.ds-menu .ds-menu-item:active:not([data-disabled]),.ds-filter-option:active:not(:disabled) { background:var(--ds-secondary); }\r\n.ds-sidebar :is(.nav-item:not(.is-active),.nav-group__title):active:not(:disabled) { background:var(--ds-border); }\r\n.ds-sidebar .nav-item.is-active:active:not(:disabled) { background:var(--ds-primary-active);color:white; }\r\n"
