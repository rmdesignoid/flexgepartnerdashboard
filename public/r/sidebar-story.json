      "content": "@import \"./tokens.css\";\r\n\r\n@import \"./documentation.css\";\r\n\r\n.ds-root { min-width:100%;min-height:0;color:var(--ds-foreground);background:transparent;font-family:var(--ds-font-sans);font-size:var(--ds-font-size-sm);line-height:var(--ds-line-height-sm); }\r\n\r\n.ds-root *, .ds-root *::before, .ds-root *::after { box-sizing:border-box; }\r\n\r\n.ds-root :is(button,input,select,textarea) { font-family:inherit; }\r\n\r\n.ds-button,.ds-input,.ds-tab { box-sizing:border-box;transition:background .15s ease,border-color .15s ease,box-shadow .15s ease,color .15s ease;font-family:var(--ds-font-sans);font-size:var(--ds-font-size-sm);line-height:var(--ds-line-height-sm);letter-spacing:.005em; }\r\n\r\n.ds-button { min-height:36px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid transparent;border-radius:var(--ds-radius-sm);cursor:pointer;font-weight:600;white-space:nowrap; }\r\n\r\n.ds-button--primary { color:white;background:var(--ds-primary); }\r\n\r\n.ds-button--primary:hover:not(:disabled):not([aria-disabled=\"true\"]) { background:var(--ds-primary-hover); }\r\n\r\n.ds-button--accent { color:white;background:var(--ds-accent); }\r\n\r\n.ds-button--accent:hover:not(:disabled):not([aria-disabled=\"true\"]) { background:var(--ds-accent-hover); }\r\n\r\n.ds-button--secondary { color:var(--ds-foreground);background:var(--ds-secondary); }\r\n\r\n.ds-button--secondary:hover:not(:disabled):not([aria-disabled=\"true\"]) { background:var(--ds-border); }\r\n\r\n.ds-button--outline { color:var(--ds-foreground);background:var(--ds-surface);border-color:var(--ds-border); }\r\n\r\n.ds-button--outline:hover:not(:disabled):not([aria-disabled=\"true\"]),.ds-button--ghost:hover:not(:disabled):not([aria-disabled=\"true\"]),.ds-button--ghost-muted:hover:not(:disabled):not([aria-disabled=\"true\"]) { background:var(--ds-secondary); }\r\n\r\n.ds-button--ghost { color:var(--ds-foreground);background:transparent; }\r\n\r\n.ds-button--ghost-muted { color:var(--ds-muted);background:transparent; }\r\n\r\n.ds-button--destructive { color:white;background:var(--ds-danger); }\r\n\r\n.ds-button--destructive:hover:not(:disabled):not([aria-disabled=\"true\"]) { background:var(--ds-danger-hover); }\r\n\r\n.ds-control--mini { min-height:24px;padding-inline:8px;font-size:var(--ds-font-size-xs);line-height:var(--ds-line-height-xs); }\r\n\r\n.ds-control--small { min-height:32px; }\r\n\r\n.ds-control--regular { min-height:36px; }\r\n\r\n.ds-control--large { min-height:40px;padding-inline:16px; }\r\n\r\n.ds-round { border-radius:9999px; }\r\n\r\n.ds-icon-button { width:36px;height:36px;padding:0;flex-shrink:0; }\r\n\r\n.ds-icon-button.ds-control--mini { width:24px;height:24px; }\r\n\r\n.ds-icon-button.ds-control--small { width:32px;height:32px; }\r\n\r\n.ds-icon-button.ds-control--large { width:40px;height:40px; }\r\n\r\n.ds-button:disabled { cursor:not-allowed;opacity:.5; }\r\n\r\n.ds-button:focus-visible,.ds-tab:focus-visible { outline:none;box-shadow:var(--ds-focus-ring); }\r\n\r\n.ds-button--destructive:focus-visible { box-shadow:var(--ds-error-ring); }\r\n\r\n.ds-spinner { width:16px;height:16px;display:inline-grid;place-items:center;flex-shrink:0;animation:ds-spin 1s linear infinite; }\r\n\r\n@keyframes ds-spin { to { transform:rotate(360deg); } }\r\n\r\n.ds-input { width:100%;min-height:32px;padding:4.5px 8px;border:1px solid var(--ds-border);border-radius:var(--ds-radius-sm);color:var(--ds-foreground);background:var(--ds-surface);box-shadow:var(--ds-shadow-sm);font-weight:400; }\r\n\r\n.ds-input::placeholder { color:var(--ds-muted);opacity:1; }\r\n\r\n.ds-input:hover:not(:disabled):not([aria-disabled=\"true\"]):not([aria-invalid=\"true\"]) { border-color:var(--ds-muted); }\r\n\r\n.ds-input:focus-visible,.ds-input[data-state=\"focus\"] { outline:none;border-color:var(--ds-primary);box-shadow:var(--ds-focus-ring); }\r\n\r\n.ds-input[aria-invalid=\"true\"],.ds-input[data-state=\"invalid\"] { border-color:var(--ds-danger); }\r\n\r\n.ds-input[aria-invalid=\"true\"]:focus-visible,.ds-input[data-state=\"error-focus\"] { outline:none;border-color:var(--ds-danger);box-shadow:var(--ds-error-ring); }\r\n\r\n.ds-input:disabled { cursor:not-allowed;opacity:.5;background:var(--ds-secondary); }\r\n\r\n.ds-input-shell,.ds-select-shell { position:relative;display:block;width:100%; }\r\n\r\n.ds-input-decoration { position:absolute;top:50%;transform:translateY(-50%);display:grid;place-items:center;pointer-events:none;color:var(--ds-muted); }\r\n\r\n.ds-input-decoration--leading { left:8px; }\r\n\r\n.ds-input-decoration--trailing { right:8px; }\r\n\r\n.ds-input-shell.has-leading .ds-input { padding-left:34px; }\r\n\r\n.ds-input-shell.has-trailing .ds-input { padding-right:34px; }\r\n\r\n.ds-textarea { min-height:76px;padding:8px;resize:vertical; }\r\n\r\n.ds-textarea:focus-visible { box-shadow:var(--ds-secondary-ring); }\r\n\r\n.ds-textarea[aria-invalid=\"true\"]:focus-visible { box-shadow:var(--ds-error-ring); }\r\n\r\n.ds-textarea--fixed { resize:none; }\r\n\r\n.ds-select-shell { --ds-select-padding:6.5px; }\r\n\r\n.ds-select-shell--small,.ds-select-shell--mini { --ds-select-padding:4.5px; }\r\n\r\n.ds-select-shell--large { --ds-select-padding:8.5px; }\r\n\r\n.ds-select { position:relative;text-align:left;appearance:none;cursor:pointer;min-height:36px;padding:6.5px 32px 6.5px 12px; }\r\n\r\n.ds-select-shell--small .ds-select,.ds-select-shell--mini .ds-select { min-height:32px;padding-block:4.5px; }\r\n\r\n.ds-select-shell--large .ds-select { min-height:40px;padding-block:8.5px; }\r\n\r\n.ds-select-decoration { display:grid;place-items:center;width:16px;height:16px;position:absolute;right:8px;top:50%;transform:translateY(-50%);pointer-events:none; }\r\n\r\n.ds-select-decoration.ds-spinner { top:calc(50% - 8px);transform:none; }\r\n\r\n.ds-select-shell.has-leading .ds-select { padding-left:40px; }\r\n\r\n.ds-select-shell.has-description .ds-select { padding-bottom:calc(var(--ds-select-padding) + 16px); }\r\n\r\n.ds-select-description { position:absolute;left:12px;bottom:6px;right:32px;color:var(--ds-muted);font-size:var(--ds-font-size-xs);line-height:var(--ds-line-height-xs);pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }\r\n\r\n.ds-select-shell.has-leading .ds-select-description { left:40px; }\r\n\r\n.ds-field { display:grid;gap:8px;min-width:0; }\r\n\r\n.ds-field__label { font-size:var(--ds-font-size-sm);line-height:var(--ds-line-height-sm);font-weight:600; }\r\n\r\n.ds-field__control { display:grid;gap:4px;min-width:0; }\r\n\r\n.ds-field--horizontal { grid-template-columns:minmax(80px,1fr) minmax(0,2fr);align-items:start;gap:16px; }\r\n\r\n.ds-field--horizontal .ds-field__label { padding-top:6px; }\r\n\r\n.ds-field__hint,.ds-field__error { font-size:var(--ds-font-size-xs);line-height:var(--ds-line-height-xs); }\r\n\r\n.ds-field__hint { color:var(--ds-muted); }\r\n\r\n.ds-field__error { color:var(--ds-danger); }\r\n\r\n.ds-badge { display:inline-flex;align-items:center;min-height:24px;padding:2px 8px;border:1px solid var(--ds-border);border-radius:9999px;font-size:var(--ds-font-size-xs);line-height:var(--ds-line-height-xs);font-weight:500;white-space:nowrap; }\r\n\r\n.ds-badge--neutral { color:var(--ds-foreground);background:var(--ds-badge-neutral); }\r\n\r\n.ds-badge--neutral.ds-badge--strong { background:var(--ds-badge-neutral-strong); }\r\n\r\n.ds-badge--danger { color:var(--ds-danger);background:var(--ds-badge-danger);border-color:var(--ds-badge-danger-border); }\r\n\r\n.ds-badge--danger.ds-badge--strong { background:var(--ds-badge-danger-strong); }\r\n\r\n.ds-badge--success { color:var(--ds-success);background:var(--ds-badge-success);border-color:var(--ds-badge-success-border); }\r\n\r\n.ds-badge--success.ds-badge--strong { background:var(--ds-badge-success-strong); }\r\n\r\n.ds-badge--info { color:var(--ds-primary);background:var(--ds-primary-soft); }\r\n\r\n.ds-badge--warning { color:var(--ds-warning);background:var(--ds-status-amber-soft); }\r\n\r\n.ds-status-badge--to-plan { color:var(--ds-status-slate);background:var(--ds-status-slate-soft); }\r\n\r\n.ds-status-badge--planning { color:var(--ds-status-amber);background:var(--ds-status-amber-soft); }\r\n\r\n.ds-status-badge--planned { color:var(--ds-status-violet);background:var(--ds-status-violet-soft); }\r\n\r\n.ds-status-badge--taught { color:var(--ds-status-teal);background:var(--ds-status-teal-soft); }\r\n\r\n.ds-avatar { display:inline-grid;place-items:center;overflow:hidden;border-radius:50%;color:var(--ds-avatar-foreground);background:var(--ds-focus-color);font-size:var(--ds-font-size-sm);line-height:var(--ds-line-height-sm);font-weight:600;flex-shrink:0; }\r\n\r\n.ds-avatar img { width:100%;height:100%;object-fit:cover; }\r\n\r\n.ds-avatar--extra-tiny { width:20px;height:20px;font-size:10px; }\r\n\r\n.ds-avatar--tiny { width:24px;height:24px;font-size:var(--ds-font-size-xs); }\r\n\r\n.ds-avatar--small { width:32px;height:32px; }\r\n\r\n.ds-avatar--regular { width:40px;height:40px; }\r\n\r\n.ds-avatar--roundrect { border-radius:var(--ds-radius-sm); }\r\n\r\n.ds-avatar-stack { display:inline-flex;align-items:center;padding-left:8px; }\r\n\r\n.ds-avatar-stack .ds-avatar { margin-left:-8px;border:1px solid var(--ds-surface); }\r\n\r\n.ds-avatar-stack__overflow { color:var(--ds-foreground);background:var(--ds-secondary);font-size:var(--ds-font-size-xs); }\r\n\r\n.ds-card { overflow:hidden;border:1px solid var(--ds-border);border-radius:var(--ds-radius-sm);background:var(--ds-surface);box-shadow:var(--ds-shadow-md); }\r\n\r\n.ds-card__header,.ds-card__body,.ds-card__footer { padding:16px; }\r\n\r\n.ds-card__header + .ds-card__body { padding-top:0; }\r\n\r\n.ds-card__footer { padding-top:0; }\r\n\r\n.ds-tabs { display:flex;gap:0;padding:6px 3px 0;border-bottom:1px solid var(--ds-border); }\r\n\r\n.ds-tab { height:40px;min-width:29px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:4px 8px;border:0;border-radius:var(--ds-radius-sm) 6px 0 0;background:transparent;color:var(--ds-muted);font-size:var(--ds-font-size-sm);line-height:var(--ds-line-height-sm);font-weight:600;cursor:pointer; }\r\n\r\n.ds-tabs--large .ds-tab { height:48px; }\r\n\r\n.ds-tabs--small .ds-tab { height:32px; }\r\n\r\n.ds-tab:hover:not(:disabled):not([aria-disabled=\"true\"]):not([aria-disabled=\"true\"]):not(.is-active) { color:var(--ds-primary);background:var(--ds-secondary); }\r\n\r\n.ds-tab.is-active { color:white;background:var(--ds-primary);box-shadow:var(--ds-shadow-md); }\r\n\r\n.ds-tab:disabled { opacity:.5;cursor:not-allowed; }\r\n\r\n.ds-tab-counter { min-width:16px;height:16px;display:inline-grid;place-items:center;padding:0 4px;border-radius:10px;background:var(--ds-border);color:var(--ds-primary);font-size:var(--ds-font-size-xs);line-height:var(--ds-line-height-xs); }\r\n\r\n.ds-empty-state { display:grid;place-items:center;gap:8px;padding:40px 24px;text-align:center; }\r\n\r\n.ds-empty-state h3,.ds-empty-state p { margin:0; }\r\n\r\n.ds-empty-state p { max-width:42ch;color:var(--ds-muted); }\r\n\r\n.ds-empty-state__icon { box-sizing:border-box;display:grid;place-items:center;width:36px;height:36px;padding:8px;border-radius:2px;background:var(--ds-placeholder); }\r\n\r\n@media (prefers-reduced-motion:reduce) { .ds-spinner { animation:none; } .ds-button,.ds-input,.ds-tab { transition:none; } }\r\n\r\n\r\n\r\n.ds-button[aria-busy=\"true\"]:disabled,.ds-input[aria-busy=\"true\"]:disabled { opacity:1;cursor:progress; }\r\n\r\n.ds-input[data-state=\"hover\"] { border-color:var(--ds-muted); }\r\n\r\n\r\n\r\n.ds-input-decoration { width:20px;height:20px; }\r\n\r\n.ds-select-shell .ds-input-decoration--leading { left:12px; }\r\n\r\n\r\n\r\n.ds-loading-button { padding-inline:16px; }\r\n\r\n.ds-loading-button.ds-control--mini { padding-inline:8px; }\r\n\r\n.ds-loading-button.ds-control--small { padding-inline:12px; }\r\n\r\n\r\n\r\n.ds-select-native { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0; }\r\n\r\n.ds-select[data-state=\"open\"] { border-color:var(--ds-primary);outline:none;box-shadow:var(--ds-focus-ring); }\r\n\r\n.ds-select[aria-invalid=\"true\"][data-state=\"open\"] { border-color:var(--ds-danger);box-shadow:var(--ds-error-ring); }\r\n\r\n.ds-select > span:first-of-type:not(.ds-input-decoration) { display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }\r\n\r\n.ds-select-menu { z-index:1000;box-sizing:border-box;min-width:var(--radix-select-trigger-width);max-width:calc(100vw - 16px);max-height:min(320px,var(--radix-select-content-available-height));overflow:hidden;border:1px solid var(--ds-border);border-radius:var(--ds-overlay-radius);background:var(--ds-surface);color:var(--ds-foreground);box-shadow:var(--ds-shadow-popover);font-family:var(--ds-font-sans);font-size:var(--ds-font-size-sm);line-height:var(--ds-line-height-sm);letter-spacing:.005em; }\r\n\r\n.ds-select-menu * { box-sizing:border-box; }\r\n\r\n.ds-select-viewport { padding:8px; }\r\n\r\n.ds-select-option { position:relative;display:flex;align-items:center;min-height:32px;gap:8px;padding:5.5px 32px 5.5px 8px;border-radius:6px;outline:none;cursor:pointer;user-select:none; }\r\n\r\n.ds-select-menu--large .ds-select-option { min-height:36px;padding-block:7.5px; }\r\n\r\n.ds-select-option[data-highlighted] { background:var(--ds-menu-highlight); }\r\n\r\n.ds-select-option[data-state=\"checked\"] { color:var(--ds-foreground);background:var(--ds-menu-selected); }\r\n\r\n.ds-select-option[data-disabled] { opacity:.5;cursor:not-allowed; }\r\n\r\n.ds-select-check { position:absolute;right:8px;width:20px;height:20px;display:grid;place-items:center; }\r\n\r\n.ds-select-group-label { min-height:32px;padding:8px;color:var(--ds-muted);font-size:var(--ds-font-size-xs);line-height:var(--ds-line-height-xs); }\r\n\r\n.ds-select-scroll { display:grid;place-items